# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (NEVER expose to the browser — server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
# Full URL of your deployment (used in password-reset redirect links)
NEXT_PUBLIC_SITE_URL=https://gpsa-uds.org

# ─────────────────────────────────────────────
# Auth setup (one-time account seeding)
# ─────────────────────────────────────────────
# Random secret to protect POST /api/setup — generate with: openssl rand -hex 32
# Keep private; only needed once to create committee accounts.
ADMIN_SETUP_SECRET=M..ahdi..313..

# ─────────────────────────────────────────────
# Resend (email notifications)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# "From" address for outgoing emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@gpsa-uds.org

# ─────────────────────────────────────────────
# Paystack (Mobile Money payments)
# ─────────────────────────────────────────────
# Public key — safe for the browser (used in the frontend for inline JS)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key

# Secret key — NEVER expose to the browser
PAYSTACK_SECRET_KEY=sk_live_your_secret_key

# Secret used to verify webhook payloads from Paystack (from Paystack dashboard)
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
